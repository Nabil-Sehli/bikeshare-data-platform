# ---------------------------------------------------------------------------
# Bike-share mobility platform - local configuration
# Copy to .env (make.ps1 / Makefile do this automatically on first run).
# All values are for a LOCAL dev stack only. Never reuse them anywhere real.
# ---------------------------------------------------------------------------

COMPOSE_PROJECT_NAME=bikeshare

# --- Postgres (data warehouse + Kestra metadata DB) -------------------------
PG_HOST=postgres
PG_PORT=5432
PG_HOST_PORT=5433
PG_DATABASE=bikeshare
PG_USER=bikeshare
PG_PASSWORD=bikeshare_local_pw
# Read-only role created by Terraform, used by the dashboard
PG_READER_USER=dashboard_reader
PG_READER_PASSWORD=reader_local_pw

# --- MinIO (S3-compatible data lake) ----------------------------------------
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin_local_pw
LAKE_BUCKET=bikeshare-lake

# --- Kafka ------------------------------------------------------------------
KAFKA_BOOTSTRAP=kafka:9092
KAFKA_TOPIC_STATION_STATUS=bikeshare.station_status
GBFS_POLL_SECONDS=60

# --- Kestra UI login --------------------------------------------------------
KESTRA_USER=admin@bikeshare.local
KESTRA_PASSWORD=Bikeshare123!

# --- Pipeline defaults ------------------------------------------------------
# JC = Jersey City (small, fast: ~100k trips/month)
# NYC = New York City (big: ~4-5M trips/month, ~1 GB zip per month)
DEFAULT_CITY=JC
BACKFILL_START_MONTH=2025-01
BACKFILL_END_MONTH=2025-12
WEATHER_START_DATE=2025-01-01
SPARK_DRIVER_MEMORY=6g
